[
  {
    "start": 0.5,
    "end": 3.05,
    "text": "اجعلْ حالتَكَ آيةً تُذكِّرُ القلوب."
  },
  {
    "start": 3.3,
    "end": 5.14,
    "text": "اختَرِ الآياتِ التي تُحِبّ،"
  },
  {
    "start": 5.7,
    "end": 7.24,
    "text": "والقارئَ والخلفيّة،"
  },
  {
    "start": 8.4,
    "end": 10.73,
    "text": "والمقاسَ المناسبَ للحالةِ أو القصّة."
  },
  {
    "start": 11.0,
    "end": 13.18,
    "text": "ثم أنشئِ الفيديو بلمسةٍ واحدة."
  },
  {
    "start": 24.2,
    "end": 26.75,
    "text": "صانعُ فيديو الآيات، في زادِ المسلم."
  },
  {
    "start": 27.0,
    "end": 28.79,
    "text": "حمِّلْهُ الآن من جوجل بلاي."
  }
]