[
  {
    "start": 0.7,
    "end": 2.29,
    "text": "الحياةُ تمضي سريعًا."
  },
  {
    "start": 2.55,
    "end": 5.19,
    "text": "لكنَّ بعضَ اللحظاتِ تستحقُّ كلَّ اهتمامِنا."
  },
  {
    "start": 5.45,
    "end": 8.13,
    "text": "امنحْ قلبَك مساحةً لما يهمُّ حقًّا."
  },
  {
    "start": 8.4,
    "end": 10.35,
    "text": "جدِّدْ صلتَك بكتابِ الله،"
  },
  {
    "start": 11.4,
    "end": 13.24,
    "text": "واستمعْ إلى أجملِ التلاوات."
  },
  {
    "start": 15.25,
    "end": 21.55,
    "text": "اجعلِ الذِّكرَ رفيقَك: أذكارُ اليوم، ومسبحةٌ ذكيّة، وأدواتٌ تُعينُك على الحفظ."
  },
  {
    "start": 22.3,
    "end": 28.8,
    "text": "تصفّحِ الأحاديث، واعرفِ اتجاهَ القبلة، واستمعْ إلى إذاعةِ القرآن، بلغتِك المفضّلة."
  },
  {
    "start": 29.4,
    "end": 32.71,
    "text": "رفيقُك في كلِّ يوم، من الفجرِ حتى الليل."
  },
  {
    "start": 35.5,
    "end": 39.1,
    "text": "زادُ المسلم. رفيقُك الإسلاميُّ المتكامل."
  },
  {
    "start": 39.35,
    "end": 42.64,
    "text": "مجانيّ، بلا إعلانات، ويعمل دون إنترنت."
  },
  {
    "start": 42.9,
    "end": 44.61,
    "text": "حمِّلْه الآن من جوجل بلاي."
  }
]