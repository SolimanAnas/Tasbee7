# Vite build output
dist/


# Environment variables (contains secrets)
.env

# Python
__pycache__/
*.pyc
*.pyo
instance/

# Node / Playwright
node_modules/
test-results/
playwright-report/

# Playwright test screenshots (generated during development)
test-*.png
tests/screenshots/*.png

# OS
Thumbs.db
.DS_Store

# Cloudflare Wrangler cache
.wrangler/

# Cloudflare Worker admin token (generated locally, contains secrets)
server/ADMIN_TOKEN.txt

# Claude Code project files
.claude/

# Editor-specific
opencode.json

# Agent tooling (local only)
.omo/
.opencode/node_modules/
**/.codegraph/

# Video maker source assets (raw originals; runtime uses images/video-maker/*.webp|mp4)
images/video-maker-originals/

# Oversized promo render (GitHub rejects files >100 MB)
promo/final.mp4

# Offline Tarteel ONNX model — downloaded by users at runtime, never commit
*.onnx

# Agent scratch files
docs/.scratches/

# Legacy test runner output (test_all.js)
test-results.json
